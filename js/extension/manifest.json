{
  "manifest_version": 3,
  "name": "Cathode",
  "version": "2.0.0",
  "description": "Real-time CRT emulation for the YouTube player: scanlines, phosphor mask, curvature, NTSC fringing, afterglow and AC hum.",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Cathode",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content.js"],
      "css": ["src/overlay.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*", "core/*", "crt/*"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
